# API công khai đang dùng
SPTV_HOME_URL=https://www.sptv.com/en/
SPTV_SCHEDULE_URL=https://www.sptv.com/data/zb.json
SPTV_PLAYER_API_URL=https://www.sptv.com/ajax_zb.php
SPTV_SCHEDULE_TIMEZONE=Asia/Shanghai

# Cửa sổ trận đấu
SPTV_PAST_MINUTES=150
SPTV_FUTURE_MINUTES=180
SPTV_MAX_MATCHES=120
SPTV_MAX_LINES_PER_MATCH=4

# Nhịp gọi thấp: tuần tự, khoảng 4-5,5 giây mỗi player API
SPTV_DELAY_MIN_SECONDS=4.0
SPTV_DELAY_MAX_SECONDS=5.5
SPTV_REQUEST_TIMEOUT=15
SPTV_NETWORK_RETRIES=1
SPTV_STOP_AFTER_DENIALS=2

# Không probe FLV; không có biến VERIFY_STREAMS vì chủ ý không gọi media CDN
SPTV_MIN_REAL_STREAMS=1
SPTV_INCLUDE_PLACEHOLDERS=0
SPTV_EMIT_HEADERS=0
SPTV_GROUP_TITLE=SP TV (China)
